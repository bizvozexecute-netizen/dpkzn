{
  "_usage": "Шаблон для каждой из 19 страниц услуг. {{...}} заполняются из данных страницы при сборке. Вставлять на страницу услуги рядом с FAQPage.",
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "{{service.h1}}",
  "serviceType": "{{service.title_short}}",
